PORT=3000

# Pick one search key. SEARCH_PROVIDER can be "tavily", "brave", or omitted for auto-detect.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# Free OpenRouter model ids (ending in ":free"). Both model settings are optional: leave them out
# and the server uses its built-in order (see DEFAULT_MODELS in server.js), which is what's below.
# Prefer models that list "structured_outputs" in their supported parameters
# (https://openrouter.ai/api/v1/models) - they're forced to return valid JSON.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_MAX_TOKENS=2000
# Comma-separated backups, tried in order when the primary model is overloaded, rate-limited, or keeps
# returning unusable output.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Optional persistent answer cache: an Upstash Redis database's REST URL and token (upstash.com,
# free tier). Without them answers are cached in data/cache.json, which hosts like Render's free tier
# wipe every time the instance restarts or spins down. GET /api/health reports which one is active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional OpenRouter attribution headers.
APP_URL=http://localhost:3000
APP_NAME=Adapt
